<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:arodriguezExamen"
             x:Class="arodriguezExamen.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Título: rojo, tamaño 20, centrado -->
            <Style x:Key="TituloStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#B71C0C" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <!-- "Usuario conectado" -->
            <Style x:Key="UsuarioStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#2BA3B4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <!-- Etiquetas de los Grid -->
            <Style x:Key="EtiquetaStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#8E0D00" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Botones -->
            <Style x:Key="BotonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2BA3B4" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>