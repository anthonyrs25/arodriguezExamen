<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="arodriguezExamen.Views.Registro"
             Title="Registro"
             BackgroundColor="#F6F2F2">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label x:Name="lblUsuario" Style="{StaticResource UsuarioStyle}" />

            <Label Text="REGISTRO" Style="{StaticResource TituloStyle}" />

            <!-- Grid 5 filas x 2 columnas -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                  RowSpacing="10" ColumnSpacing="10">

                <Label Grid.Row="0" Grid.Column="0" Text="Fecha:"
                       Style="{StaticResource EtiquetaStyle}" />
                <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpFecha" />

                <Label Grid.Row="1" Grid.Column="0" Text="País:"
                       Style="{StaticResource EtiquetaStyle}" />
                <Picker Grid.Row="1" Grid.Column="1" x:Name="pkPais"
                        Title="Seleccione un país" />

                <Label Grid.Row="2" Grid.Column="0" Text="Ciudad:"
                       Style="{StaticResource EtiquetaStyle}" />
                <Picker Grid.Row="2" Grid.Column="1" x:Name="pkCiudad"
                        Title="Seleccione una ciudad" />

                <Label Grid.Row="3" Grid.Column="0" Text="Monto inicial:"
                       Style="{StaticResource EtiquetaStyle}" />
                <!-- Entry y botón comparten la misma celda -->
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" x:Name="txtMonto" Keyboard="Numeric"
                           Placeholder="Ingrese el monto" />
                    <Button Grid.Column="1" x:Name="btnCalcular" Text="Calcular"
                            Style="{StaticResource BotonStyle}"
                            Clicked="btnCalcular_Clicked" />
                </Grid>

                <Label Grid.Row="4" Grid.Column="0" Text="Pago mensual:"
                       Style="{StaticResource EtiquetaStyle}" />
                <Entry Grid.Row="4" Grid.Column="1" x:Name="txtPagoMensual"
                       IsReadOnly="True" Placeholder="Campo calculado" />
            </Grid>

            <!-- Grid 2 filas x 3 columnas -->
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*"
                  RowSpacing="5" ColumnSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Nombre"
                       Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="0" Grid.Column="1" Text="Apellido"
                       Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="0" Grid.Column="2" Text="Edad"
                       Style="{StaticResource EtiquetaStyle}" />

                <Entry Grid.Row="1" Grid.Column="0" x:Name="txtNombre"
                       Placeholder="Ingresar Nombre" />
                <Entry Grid.Row="1" Grid.Column="1" x:Name="txtApellido"
                       Placeholder="Ingresar Apellido" />
                <Entry Grid.Row="1" Grid.Column="2" x:Name="txtEdad"
                       Placeholder="Ingresar Edad" Keyboard="Numeric" />
            </Grid>

            <Button x:Name="btnResumen" Text="Ver Resumen"
                    Style="{StaticResource BotonStyle}"
                    Clicked="btnResumen_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>