<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="arodriguezExamen.Views.Resumen"
             Title="Resumen"
             BackgroundColor="#F6F2F2">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label x:Name="lblUsuario" Style="{StaticResource UsuarioStyle}" />

            <Label Text="RESUMEN" Style="{StaticResource TituloStyle}" />

            <!-- Grid 9 filas x 2 columnas -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*" RowSpacing="12" ColumnSpacing="15">

                <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="lblNombre" />

                <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="lblApellido" />

                <Label Grid.Row="2" Grid.Column="0" Text="Edad:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="2" Grid.Column="1" x:Name="lblEdad" />

                <Label Grid.Row="3" Grid.Column="0" Text="Fecha:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="3" Grid.Column="1" x:Name="lblFecha" />

                <Label Grid.Row="4" Grid.Column="0" Text="Ciudad:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="4" Grid.Column="1" x:Name="lblCiudad" />

                <Label Grid.Row="5" Grid.Column="0" Text="País:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="5" Grid.Column="1" x:Name="lblPais" />

                <Label Grid.Row="6" Grid.Column="0" Text="Monto inicial:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="6" Grid.Column="1" x:Name="lblMonto" />

                <Label Grid.Row="7" Grid.Column="0" Text="Pago mensual:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="7" Grid.Column="1" x:Name="lblPagoMensual" />

                <Label Grid.Row="8" Grid.Column="0" Text="Pago total:" Style="{StaticResource EtiquetaStyle}" />
                <Label Grid.Row="8" Grid.Column="1" x:Name="lblPagoTotal" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>